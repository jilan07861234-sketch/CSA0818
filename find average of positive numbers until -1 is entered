total = 0
count = 0

while True:
    num = int(input("Enter a positive number (-1 to stop): "))
    if num == -1:
        break
    if num > 0:
        total += num
        count += 1

if count > 0:
    average = total / count
    print("Average of positive numbers:", average)
else:
    print("No positive numbers were entered.")
