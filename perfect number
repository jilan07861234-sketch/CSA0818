number=int(input("enter any number:"))
sum=0
for i in range(1,number):
    if(number%i==0):
        sum=sum+i
if(sum==number):
    print("%d is a perfect number"%number)
else:
    print("%d is not a perfect number"%number)


Output:
enter any number:6
6 is a perfect number
enter any number:10
10 is not a perfect number
